root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

# BOM なしで保存すると、日本語ロケールの Windows PowerShell 5.1 ではコメントが文字化けし、スクリプト実行不可。
[*.{ps1,psd1,psm1}]
charset = utf-8-bom
indent_size = 4

[*.{md,json,yml,yaml,html}]
charset = utf-8

[*.{json,yml,yaml}]
indent_size = 2

# Markdown は行末の 2 つの空白が改行を表すため、行末の空白を削除しない。
[*.md]
trim_trailing_whitespace = false
